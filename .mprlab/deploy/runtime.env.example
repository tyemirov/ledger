# Documentation only: never source, copy, or use this file as runtime configuration.
# Operational values are intentionally goofy and non-operational. Create a private ignored env file.
# Boolean, numeric, and enum entries remain type-valid documentation, not runnable defaults.

# Create a private ignored environment file and configure it explicitly.
# Docker volume maps to /srv/data inside the container.
DATABASE_URL=sqlite:///tmp/goofy-do-not-use/database-url.db

# Bind on all interfaces in the container.
GRPC_LISTEN_ADDR=127.0.0.42:4242

# Per-tenant secret keys for Bearer token authentication.
# Keep these aligned with configs/config.ledger.yml and the client env files.
POODLESCANNER_TENANT_SECRET=goofy-not-real-disco-pickle
HECATE_TENANT_SECRET=goofy-not-real-moon-cheese
NAMESIGNAL_TENANT_SECRET=goofy-not-real-waffle-wizard
